# ---------------------------------------------------------------------------
# collab-kit runtime state
#
# $COLLAB_HOME defaults to the kit directory (this repo), so a working install
# writes its live state right here. None of it belongs in a commit.
# NOTE: git does not support trailing comments in .gitignore -- every comment
# below is on its own line on purpose.
# ---------------------------------------------------------------------------

# your private registry of collabs (collabs.json.example stays tracked)
collabs.json
!collabs.json.example

# watcher state, bridge state, locks
logs/

# agents -> you (Telegram bridge queue)
outbox/

# you -> agents (from-user-*.md drops)
inbox/

# machine-local overrides and install.sh backups
*.local
.collab-kit.bak
*.collab-kit.bak

# ---------------------------------------------------------------------------
# Secrets
#
# This repository is public. No credential may ever enter the tree -- tokens
# and account ids live in the shell environment only. Nothing in this repo
# loads a dotenv file, so a .env here is inert as well as unsafe; these
# patterns exist so an accidental one cannot be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Node / pnpm (dev tooling only; the package has zero dependencies) ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# ---- engine package (uv) ----
# The engine has dependencies; collab-kit still has none. Its virtualenv and
# caches never enter the repo -- uv.lock is what makes installs reproducible.
engine/.venv/
.venv/
.uv/
.uv-cache/
