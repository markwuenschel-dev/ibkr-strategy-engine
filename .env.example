# Copy to .env and fill in. .env is git-ignored; this example is not.
#
#     cp .env.example .env
#
# Precedence: a variable already set in your shell WINS over this file. That is
# deliberate -- an explicit export or a CI secret must not be shadowed by a
# stale file. Delete a line here if you would rather export it.
#
# Everything after `=` is taken literally, including `#`. Quote a value only if
# it has leading or trailing spaces you need to keep.
#
# Loaded by `engine` (engine/src/engine/cli.py) and by tools/telegram-bridge.py.
# The nearest .env at or above the working directory wins, so this one at the
# repo root serves both.

# ---------------------------------------------------------------------------
# IBKR engine
# ---------------------------------------------------------------------------

# REQUIRED. The paper account the broker must be serving. The engine asserts
# managedAccounts() contains exactly this before it will do anything.
# Find it in TWS: Account > Account Window.
IBKR_ACCOUNT_ID=

# Paper endpoints only: 7497 (TWS paper) or 4002 (IB Gateway paper).
# 7496 and 4001 are live and are refused at config load -- there is no flag
# that changes that, by design.
#IBKR_PORT=7497
#IBKR_HOST=127.0.0.1
#IBKR_CLIENT_ID=17

# Caps. Tiny on purpose while this is a walking skeleton.
#IBKR_MAX_ORDER_NOTIONAL=1000
#IBKR_MAX_POSITION_QTY=10
#IBKR_MAX_ORDERS_PER_SESSION=5
#IBKR_MAX_MARGIN_IMPACT=5000
#IBKR_SYMBOL_ALLOWLIST=SPY,AAPL,MSFT

# Where the order journal, HALT file and lock live. Default: ./.engine
#IBKR_STATE_DIR=

# Tag on outbox alerts. Default: ibkr
#IBKR_PROJECT=ibkr

# ---------------------------------------------------------------------------
# Telegram bridge
# ---------------------------------------------------------------------------

# From @BotFather. Shaped <id>:<secret>.
TELEGRAM_BOT_TOKEN=

# Optional: pin one chat instead of letting the first message bind it.
#TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# collab-kit
# ---------------------------------------------------------------------------

# Data root for outbox/, inbox/, logs/. Defaults to the kit directory, which is
# this repo. The engine and the bridge MUST agree on this value.
#COLLAB_HOME=

# NOTE: KIT_DIR cannot be set here. It is what locates collab-kit in the first
# place, so it has to be a real environment variable. A plain checkout does not
# need it at all.
